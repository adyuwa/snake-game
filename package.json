{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "貪吃蛇手機遊戲",
  "private": true,
  "scripts": {
    "cap:init":   "npx cap init \"貪吃蛇 Snake\" com.snakegame.app --web-dir .",
    "cap:add":    "npx cap add android",
    "cap:sync":   "npx cap sync android",
    "cap:open":   "npx cap open android",
    "cap:build":  "npx cap sync android && npx cap open android",
    "apk:debug":  "cd android && gradlew assembleDebug",
    "apk:release":"cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
